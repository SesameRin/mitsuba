<!--
   Demo scene for the LayeredBSDF + grazing emitter.

   Three side-by-side spheres with progressively richer layered
   materials, lit by a constant environment plus a tight grazing
   "key" light. Shows:
     * the dielectric Fresnel rim,
     * Beer-Lambert tinting of the diffuse base by the absorbing
       layer,
     * volumetric scattering inside the layer (whitening of the
       grazing region with a forward-scattering HG phase function).
-->
<scene version="0.6.0">
    <integrator type="path">
        <integer name="maxDepth" value="12"/>
        <integer name="rrDepth" value="6"/>
    </integrator>

    <sensor type="perspective">
        <float name="fov" value="45"/>
        <transform name="toWorld">
            <lookAt origin="0, 0.6, 6" target="0, 0, 0" up="0, 1, 0"/>
        </transform>
        <film type="hdrfilm">
            <integer name="width" value="640"/>
            <integer name="height" value="240"/>
            <boolean name="banner" value="false"/>
        </film>
        <sampler type="ldsampler">
            <integer name="sampleCount" value="64"/>
        </sampler>
    </sensor>

    <emitter type="constant">
        <spectrum name="radiance" value="0.4"/>
    </emitter>

    <!-- Tight grazing key light from camera-left -->
    <emitter type="grazing">
        <spectrum name="intensity" value="200"/>
        <float name="cutoffAngle" value="10"/>
        <float name="exponent" value="32"/>
        <transform name="toWorld">
            <lookAt origin="-6, 0.0, 0" target="0, 0, 0" up="0, 1, 0"/>
        </transform>
    </emitter>

    <!-- Dielectric over diffuse, no scattering: matches `coating`. -->
    <shape type="sphere">
        <point name="center" x="-2.2" y="0" z="0"/>
        <float name="radius" value="1"/>
        <bsdf type="layered">
            <float name="intIOR" value="1.5"/>
            <float name="extIOR" value="1.0"/>
            <float name="thickness" value="0"/>
            <bsdf type="diffuse">
                <rgb name="reflectance" value="0.7 0.2 0.15"/>
            </bsdf>
        </bsdf>
    </shape>

    <!-- Absorbing tinted layer over diffuse base. -->
    <shape type="sphere">
        <point name="center" x="0" y="0" z="0"/>
        <float name="radius" value="1"/>
        <bsdf type="layered">
            <float name="intIOR" value="1.5"/>
            <float name="extIOR" value="1.0"/>
            <float name="thickness" value="0.6"/>
            <rgb name="sigmaA" value="0.5 1.0 1.5"/>
            <bsdf type="diffuse">
                <rgb name="reflectance" value="0.9 0.9 0.9"/>
            </bsdf>
        </bsdf>
    </shape>

    <!-- Scattering layer with forward-scattering HG, over diffuse. -->
    <shape type="sphere">
        <point name="center" x="2.2" y="0" z="0"/>
        <float name="radius" value="1"/>
        <bsdf type="layered">
            <float name="intIOR" value="1.5"/>
            <float name="extIOR" value="1.0"/>
            <float name="thickness" value="0.4"/>
            <rgb name="sigmaA" value="0.05 0.1 0.2"/>
            <rgb name="sigmaS" value="3.0 3.0 3.0"/>
            <phase type="hg">
                <float name="g" value="0.5"/>
            </phase>
            <bsdf type="diffuse">
                <rgb name="reflectance" value="0.5 0.5 0.5"/>
            </bsdf>
        </bsdf>
    </shape>
</scene>
